{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/impulse-collision-output.schema.json",
  "title": "Hakoniwa Impulse collision output configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "spec", "pdu_config", "policy"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirror_component"],
      "properties": {"mirror_component": {"type": "string", "minLength": 1}}
    },
    "pdu_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdu_name", "message_type"],
      "properties": {
        "pdu_name": {"type": "string", "minLength": 1},
        "message_type": {"const": "hako_msgs/ImpulseCollision"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restitution_coefficient", "relative_normal_speed_threshold_mps", "cooldown_sec"],
      "properties": {
        "restitution_coefficient": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "relative_normal_speed_threshold_mps": {"type": "number", "minimum": 0.0},
        "cooldown_sec": {"type": "number", "exclusiveMinimum": 0.0}
      }
    }
  }
}
