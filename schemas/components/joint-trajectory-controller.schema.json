{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/robot-arm-joint-trajectory-controller.schema.json",
  "title": "Robot Arm JointTrajectory Controller",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "joints"],
  "properties": {
    "$schema": { "type": "string" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdu_name", "update_rate_hz", "message_type"],
      "properties": {
        "pdu_name": { "type": "string", "minLength": 1 },
        "update_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "message_type": { "const": "trajectory_msgs/JointTrajectory" }
      }
    },
    "joints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "actuator"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "actuator": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
