{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/multi-dof-joint-state-output.schema.json",
  "title": "Hakoniwa MultiDOF body-state output",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "mjcf_binding", "pdu_config"],
  "properties": {
    "$schema": {"type": "string"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "bodies"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "bodies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {"name": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "mjcf_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bodies"],
      "properties": {
        "bodies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "mjcf_freejoint"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "mjcf_freejoint": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "pdu_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdu_name", "message_type", "update_rate_hz"],
      "properties": {
        "pdu_name": {"type": "string", "minLength": 1},
        "message_type": {"const": "sensor_msgs/MultiDOFJointState"},
        "update_rate_hz": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
