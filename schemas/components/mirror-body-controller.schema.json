{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/mirror-body-controller.schema.json",
  "title": "Hakoniwa Mirror body controller configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "spec", "input", "mjcf_binding"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mirror_id"],
      "properties": {"mirror_id": {"type": "string", "minLength": 1}}
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pose"],
      "properties": {
        "pose": {"$ref": "#/$defs/twistPdu"},
        "velocity": {"$ref": "#/$defs/velocityPdu"}
      }
    },
    "mjcf_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freejoint", "contact_bodies"],
      "properties": {
        "freejoint": {"type": "string", "minLength": 1},
        "contact_bodies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["body_id", "mjcf_freejoint"],
            "properties": {
              "body_id": {"type": "string", "minLength": 1},
              "mjcf_freejoint": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "twistPdu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdu_name", "message_type"],
      "properties": {
        "pdu_name": {"type": "string", "minLength": 1},
        "message_type": {"const": "geometry_msgs/Twist"}
      }
    },
    "velocityPdu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdu_name", "message_type", "frame"],
      "properties": {
        "pdu_name": {"type": "string", "minLength": 1},
        "message_type": {"const": "geometry_msgs/Twist"},
        "frame": {"enum": ["world", "body"]}
      }
    }
  }
}
