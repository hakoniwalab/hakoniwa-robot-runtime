{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/geom-friction-controller.schema.json",
  "title": "Hakoniwa geom friction controller configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "input"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geoms"],
      "properties": {
        "geoms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdu_name", "message_type"],
      "properties": {
        "pdu_name": {"type": "string", "minLength": 1},
        "message_type": {"const": "std_msgs/Float64"}
      }
    }
  }
}
