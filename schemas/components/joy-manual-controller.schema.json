{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/robot-arm-joy-manual-controller.schema.json",
  "title": "Robot Arm Joy Manual Controller",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "id", "joy_layout", "input", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "joy_layout": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdu_name", "message_type", "update_rate_hz", "timeout_sec"],
      "properties": {
        "pdu_name": { "type": "string", "minLength": 1 },
        "message_type": { "const": "sensor_msgs/Joy" },
        "update_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "timeout_sec": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual_enable_button", "quit_button", "deadzone", "expo", "banks"],
      "properties": {
        "manual_enable_button": { "type": "string", "minLength": 1 },
        "quit_button": { "type": "string", "minLength": 1 },
        "deadzone": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "expo": { "type": "number", "minimum": 0, "maximum": 1 },
        "banks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "select_button", "bindings"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "select_button": { "type": ["string", "null"] },
              "bindings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["axis", "joint", "velocity_rad_s"],
                  "properties": {
                    "axis": { "type": "string", "minLength": 1 },
                    "joint": { "type": "string", "minLength": 1 },
                    "velocity_rad_s": { "type": "number", "exclusiveMinimum": 0 },
                    "invert": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
