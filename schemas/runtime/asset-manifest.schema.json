{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/robot-runtime-asset-manifest.schema.json",
  "title": "Hakoniwa Robot Runtime asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "model", "pdu_def", "endpoint", "runtime_config", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "name": { "$ref": "#/$defs/nonempty_string" },
    "description": { "type": "string" },
    "model": { "$ref": "#/$defs/nonempty_string" },
    "pdu_def": { "$ref": "#/$defs/nonempty_string" },
    "endpoint": { "$ref": "#/$defs/nonempty_string" },
    "runtime_config": { "$ref": "#/$defs/nonempty_string" },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "robots": {
      "type": "array",
      "items": { "$ref": "#/$defs/robot" }
    }
  },
  "$defs": {
    "nonempty_string": { "type": "string", "minLength": 1 },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "type", "config"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty_string" },
        "kind": { "enum": ["sensor", "actuator", "state_output", "command_input", "controller"] },
        "type": { "$ref": "#/$defs/nonempty_string" },
        "config": { "$ref": "#/$defs/nonempty_string" },
        "pdu_robot": { "$ref": "#/$defs/nonempty_string" },
        "description": { "type": "string" }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "services"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Unique robot name matching the PDU robot."
        },
        "builtin": { "enum": ["ackermann_step", "person_step"] },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/service" },
          "description": "Services in index order."
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["library"],
          "properties": {
            "library": {
              "$ref": "#/$defs/nonempty_string",
              "description": "Shared library path relative to this manifest, or an absolute path."
            },
            "config": { "description": "JSON value passed to the plugin.", "default": {} }
          }
        },
        "priority": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "default": 16
        }
      },
      "if": { "required": ["plugin"] },
      "then": { "not": { "required": ["builtin"] } },
      "else": { "required": ["builtin"], "not": { "required": ["priority"] } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Registered Core service name, unique across all robots."
        },
        "lockstep": { "type": "boolean", "default": false }
      }
    }
  }
}
