{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/robot-arm-actuator-runtime.schema.json",
  "title": "Hakoniwa Robot Arm Actuator Runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["actuators"],
  "properties": {
    "$schema": { "type": "string" },
    "initial_body_poses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mjcf_freejoint", "position_m", "orientation_rpy_rad"],
        "properties": {
          "mjcf_freejoint": { "type": "string", "minLength": 1 },
          "position_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "orientation_rpy_rad": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        }
      }
    },
    "actuators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_timeout_sec"],
        "properties": {
          "command_timeout_sec": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Command lifetime measured only in simulation time."
          }
        }
      }
    }
  }
}
