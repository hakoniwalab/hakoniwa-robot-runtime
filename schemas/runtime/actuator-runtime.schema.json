{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/robot-arm-actuator-runtime.schema.json",
  "title": "Hakoniwa Robot Arm Actuator Runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["actuators"],
  "properties": {
    "$schema": { "type": "string" },
    "sensors": {
      "description": "Sensors (opt-in build only): the random seed, and where the simulated world is on the earth. The MuJoCo world axes are NWU (x north, y west, z up) from origin.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "description": "Random seed of every sensor; each sensor's stream is derived from it with the robot and sensor names.",
          "type": "integer",
          "minimum": 0
        },
        "world": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origin": {
              "description": "WGS-84 position of the world origin. Required by GPS receivers and barometers.",
              "type": "object",
              "additionalProperties": false,
              "required": ["latitude_deg", "longitude_deg", "altitude_m"],
              "properties": {
                "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude_deg": { "type": "number", "minimum": -180, "maximum": 180 },
                "altitude_m": {
                  "description": "Height of the origin above sea level [m]; without a geoid model it is also used as the height above the ellipsoid.",
                  "type": "number"
                }
              }
            },
            "magnetic_field": {
              "description": "Earth magnetic field at the world. Required by magnetometers.",
              "type": "object",
              "additionalProperties": false,
              "required": ["intensity_nT", "declination_deg", "inclination_deg"],
              "properties": {
                "intensity_nT": { "type": "number", "exclusiveMinimum": 0 },
                "declination_deg": { "description": "Positive east of true north.", "type": "number" },
                "inclination_deg": { "description": "Positive downward.", "type": "number" }
              }
            },
            "atmosphere": {
              "description": "Weather at sea level for barometers; the standard atmosphere when omitted.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sea_level_pressure_pa": { "type": "number", "exclusiveMinimum": 0, "default": 101325 },
                "sea_level_temperature_c": { "type": "number", "default": 15 }
              }
            }
          }
        }
      }
    },
    "initial_body_poses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mjcf_freejoint", "position_m", "orientation_rpy_rad"],
        "properties": {
          "mjcf_freejoint": { "type": "string", "minLength": 1 },
          "position_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "orientation_rpy_rad": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        }
      }
    },
    "person_initial_poses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "yaw_rad"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "yaw_rad": { "type": "number" }
        }
      }
    },
    "person_vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mjcf_freejoint", "seats"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mjcf_freejoint": { "type": "string", "minLength": 1 },
          "seats": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "minLength": 1 },
            "additionalProperties": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number" }
            }
          }
        }
      }
    },
    "actuators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_timeout_sec"],
        "properties": {
          "command_timeout_sec": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Command lifetime measured only in simulation time."
          }
        }
      }
    }
  }
}
