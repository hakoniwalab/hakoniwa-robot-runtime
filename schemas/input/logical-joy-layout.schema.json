{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/logical-joy-layout.schema.json",
  "title": "Hakoniwa Logical Joy Layout",
  "description": "Logical axis/button names consumed by the Robot Runtime Joy Manual Controller.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "axes", "buttons"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "axes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "buttons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
