cmake_minimum_required(VERSION 3.21)

include("${CMAKE_CURRENT_LIST_DIR}/../cmake/HakoniwaRobotRuntimeSources.cmake")

file(GLOB_RECURSE source_files LIST_DIRECTORIES FALSE "${HAKO_RUNTIME_SRC_DIR}/*.cpp")
get_cmake_property(variables VARIABLES)
set(listed_sources)
foreach(variable IN LISTS variables)
    if(variable MATCHES "^HAKO_RUNTIME_[A-Z0-9_]+_SOURCES$")
        foreach(source IN LISTS ${variable})
            if(source IN_LIST listed_sources)
                message(FATAL_ERROR "Runtime source is listed more than once: ${source}")
            endif()
            if(NOT source IN_LIST source_files)
                message(FATAL_ERROR "${variable} lists a file outside the Runtime C++ sources: ${source}")
            endif()
            list(APPEND listed_sources "${source}")
        endforeach()
    endif()
endforeach()

list(REMOVE_ITEM source_files ${listed_sources})
if(source_files)
    list(JOIN source_files "\n  " missing_sources)
    message(FATAL_ERROR "Runtime sources missing from the catalog:\n  ${missing_sources}")
endif()

list(LENGTH listed_sources source_count)
message(STATUS "Runtime source catalog covers all ${source_count} C++ sources")
