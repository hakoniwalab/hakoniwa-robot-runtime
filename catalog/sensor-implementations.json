{
  "schema_version": 1,
  "description": "Sensor implementations and the keys of the common sensor definition file each one supports. A key path covers its subtree; the top-level \"type\" and \"$schema\" are always allowed. A definition that uses a key not listed here for the chosen implementation is rejected at start-up.",
  "implementations": {
    "hakoniwa": {
      "sensors": {
        "force_torque": {
          "keys": [
            "update_rate", "range", "overload", "delay", "lowpass_cutoff_hz",
            "nonlinearity", "scale_error", "crosstalk", "bias", "drift_per_hour",
            "noise", "resolution", "tare_window"
          ]
        },
        "joint": {
          "keys": ["update_rate", "delay", "encoder", "velocity", "torque"]
        },
        "imu": {
          "keys": ["components.sensors.imu", "components.sensors.gyro", "components.sensors.acc"]
        },
        "lidar": {
          "keys": ["update_rate", "scan_mode", "scan", "range", "no_return", "accuracy"]
        }
      }
    },
    "gazebo": {
      "sensors": {
        "force_torque": {
          "keys": ["update_rate", "noise", "bias", "resolution"]
        }
      }
    },
    "airsim": {
      "sensors": {}
    }
  }
}
