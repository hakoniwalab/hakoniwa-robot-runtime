<?xml version="1.0"?>
<sdf version="1.9">
  <world name="iiwa14_contact">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>@REAL_TIME_FACTOR@</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>
    <gravity>0 0 -9.81</gravity>

    <model name="contact_table">
      <static>true</static>
      <pose>0.6 0 0.18 0 0 0</pose>
      <link name="tabletop">
        <collision name="tabletop"><geometry><box><size>0.6 0.6 0.04</size></box></geometry></collision>
        <visual name="tabletop">
          <geometry><box><size>0.6 0.6 0.04</size></box></geometry>
          <material><ambient>0.75 0.7 0.6 1</ambient><diffuse>0.75 0.7 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
