<?xml version="1.0"?>
<!-- The SO-101 pick-and-place world in Gazebo, as the Hakoniwa Robot Runtime's
     work cell (so101.environment.xml): the floor, the front wall, the two posts,
     the 30 mm cube (30 g) at (0.28, 0) and the overhead 3D LiDAR
     (overhead-lidar3d.json: 360 x 32 rays, 2 Hz, 0.05-2 m). The physics step
     is that of the Robot Runtime (2 ms).
     Friction: MuJoCo uses the larger of two surfaces, Gazebo the smaller; the
     values here give the same pairs (cube-floor 1.0, cube-jaw pad 2.0). The
     LiDAR renders the visuals, so every body has its visual. -->
<sdf version="1.9">
  <world name="so101">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>@REAL_TIME_FACTOR@</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>
    <gravity>0 0 -9.81</gravity>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>2.4 2.4</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>2.4 2.4</size></plane></geometry>
        </visual>
      </link>
    </model>

    <model name="front_wall">
      <static>true</static>
      <pose>-0.48 0 0.24 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 0.64 0.48</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.64 0.48</size></box></geometry></visual>
      </link>
    </model>
    <model name="left_post">
      <static>true</static>
      <pose>-0.18 0.4 0.24 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.16 0.08 0.48</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.16 0.08 0.48</size></box></geometry></visual>
      </link>
    </model>
    <model name="right_post">
      <static>true</static>
      <pose>-0.18 -0.4 0.24 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.16 0.08 0.48</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.16 0.08 0.48</size></box></geometry></visual>
      </link>
    </model>

    <model name="grasp_cube">
      <pose>0.28 0 0.016 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia><ixx>4.5e-6</ixx><iyy>4.5e-6</iyy><izz>4.5e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.03 0.03 0.03</size></box></geometry></visual>
      </link>
    </model>

    <model name="overhead_lidar">
      <static>true</static>
      <pose>0.28 0.25 0.5 0 0 0</pose>
      <link name="housing">
        <collision name="collision"><geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry></visual>
        <sensor name="overhead_lidar" type="gpu_lidar">
          <pose>0 0 -0.025 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>/pdu/lidar_scan</topic>
          <gz_frame_id>overhead_lidar</gz_frame_id>
          <lidar>
            <scan>
              <horizontal><samples>360</samples><min_angle>-3.141592653589793</min_angle><max_angle>-0.008726646259971549</max_angle></horizontal>
              <vertical><samples>32</samples><min_angle>-1.4835298641951802</min_angle><max_angle>-0.6108652381980153</max_angle></vertical>
            </scan>
            <range><min>0.05</min><max>2.0</max></range>
          </lidar>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
