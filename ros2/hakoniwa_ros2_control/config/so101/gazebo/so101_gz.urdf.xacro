<?xml version="1.0"?>
<!-- SO-101 in Gazebo (Harmonic) with gz_ros2_control, for comparing with
     Hakoniwa: the arm's own URDF is included unchanged (argument so101_urdf),
     the joints and controllers are those of so101_asset.urdf.xacro and
     ros2_controllers.yaml. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101">
  <xacro:arg name="so101_urdf" default=""/>
  <xacro:arg name="controllers" default=""/>
  <xacro:include filename="$(arg so101_urdf)"/>

  <!-- With sensors:=true, the pick-and-place set-up of Hakoniwa
       (asset-manifest-sensors.json): the sensor frames as so101_asset.urdf.xacro,
       the wrist force-torque sensor, and the jaw pads of the Robot Runtime's
       model (so101.environment.xml: boxes 40 x 12 x 3 mm, friction 2.0). -->
  <xacro:arg name="sensors" default="false"/>
  <!-- The pads are physics only (as in Hakoniwa, where MoveIt's robot has none):
       jaw_pads:=true for the robot Gazebo simulates, false for MoveIt and TF. -->
  <xacro:arg name="jaw_pads" default="true"/>
  <xacro:if value="$(arg sensors)">
    <link name="overhead_lidar"/>
    <joint name="overhead_lidar_mount" type="fixed">
      <parent link="base_link"/>
      <child link="overhead_lidar"/>
      <origin xyz="0.28 0.25 0.475" rpy="0 0 0"/>
    </joint>
    <link name="wrist_ft"/>
    <joint name="wrist_ft_mount" type="fixed">
      <parent link="gripper_link"/>
      <child link="wrist_ft"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>
  <xacro:if value="${'$(arg sensors)' == 'true' and '$(arg jaw_pads)' == 'true'}">
    <link name="fixed_jaw_pad">
      <inertial><mass value="1e-4"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
      <collision><geometry><box size="0.04 0.012 0.003"/></geometry></collision>
    </link>
    <joint name="fixed_jaw_pad_mount" type="fixed">
      <parent link="gripper_link"/>
      <child link="fixed_jaw_pad"/>
      <origin xyz="-0.0094 -0.00021812 -0.0781274" rpy="0 1.5707963267948966 0"/>
    </joint>
    <link name="moving_jaw_pad">
      <inertial><mass value="1e-4"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
      <collision><geometry><box size="0.04 0.012 0.003"/></geometry></collision>
    </link>
    <joint name="moving_jaw_pad_mount" type="fixed">
      <parent link="moving_jaw_so101_v1_link"/>
      <child link="moving_jaw_pad"/>
      <origin xyz="-0.01218464 -0.05346198 0.01901812" rpy="-1.5707963267948966 0 -1.8569273147895142"/>
    </joint>
    <!-- Gazebo combines two surfaces' friction by the smaller one, MuJoCo by the
         larger: pad-cube 2.0 needs 2.0 on both (the world's cube has 2.0). -->
    <gazebo reference="fixed_jaw_pad"><collision><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision></gazebo>
    <gazebo reference="moving_jaw_pad"><collision><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision></gazebo>
  </xacro:if>
  <xacro:if value="$(arg sensors)">
    <!-- The wrist force-torque sensor at the gripper (the joint into it), at
         the rate Hakoniwa publishes it (sensor_publish.json). -->
    <gazebo reference="wrist_roll">
      <sensor name="wrist_ft" type="force_torque">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/pdu/wrist_wrench</topic>
        <gz_frame_id>wrist_ft</gz_frame_id>
        <force_torque><frame>child</frame><measure_direction>child_to_parent</measure_direction></force_torque>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- Fixed to the world at the origin, as in Hakoniwa. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <xacro:macro name="gz_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="so101_gazebo" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:gz_joint name="shoulder_pan"/>
    <xacro:gz_joint name="shoulder_lift"/>
    <xacro:gz_joint name="elbow_flex"/>
    <xacro:gz_joint name="wrist_flex"/>
    <xacro:gz_joint name="wrist_roll"/>
    <xacro:gz_joint name="gripper"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers)</parameters>
    </plugin>
  </gazebo>
</robot>
