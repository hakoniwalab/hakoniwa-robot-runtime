{
  "version": "0.1",
  "defaults": {
    "cwd": "/workspace/hakoniwa-robot-arm",
    "stdout": "/tmp/compare/physics-${asset}.out",
    "stderr": "/tmp/compare/physics-${asset}.err",
    "start_grace_sec": 2,
    "delay_sec": 1,
    "env": {
      "set": {
        "HAKO_CONFIG_PATH": "/workspace/work-docker-jazzy/foundation/config/cpp_core_config.json",
        "HAKO_PDU_ENDPOINT_SHARED_LIB": "/workspace/work-docker-jazzy/foundation/install/lib/libhakoniwa_pdu_endpoint_core_callback.so",
        "PYTHONUNBUFFERED": "1"
      },
      "prepend": {
        "lib_path": [
          "/workspace/work-docker-jazzy/foundation/install/lib"
        ],
        "PATH": [
          "/workspace/work-docker-jazzy/foundation/install/python/bin",
          "/workspace/work-docker-jazzy/foundation/install/bin"
        ]
      }
    }
  },
  "assets": [
    {
      "name": "so101-plant",
      "activation_timing": "before_start",
      "command": "/workspace/work-docker-jazzy/recipes/so101-joint-trajectory-control/build/bin/robot-arm-hakoniwa-asset",
      "args": [
        "--manifest",
        "/workspace/work-docker-jazzy/recipes/so101-joint-trajectory-control/config/asset-manifest-environment.json",
        "--no-viewer",
        "--realtime-sync-cycle-msec",
        "0"
      ],
      "delay_sec": 2
    }
  ]
}
